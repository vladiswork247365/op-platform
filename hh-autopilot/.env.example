# ── Runtime mode ────────────────────────────────────────────────────────────
# dry_run (default, safe — sends nothing) | production (really applies)
RUN_MODE=dry_run

# ── Storage ─────────────────────────────────────────────────────────────────
# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/autopilot.db

# ── Vacancy source ──────────────────────────────────────────────────────────
# headhunter (real api.hh.ru) | mock (offline demo / dry-run without network)
VACANCY_SOURCE=mock
HH_API_BASE=https://api.hh.ru
HH_USER_AGENT=hh-autopilot/1.0 (your-email@example.com)
# Required ONLY to send applications (leave empty for search/analysis only):
HH_ACCESS_TOKEN=
HH_RESUME_ID=

# ── AI provider ─────────────────────────────────────────────────────────────
# anthropic (real analysis) | mock (deterministic offline scoring)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=1024

# ── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SEARCH_INTERVAL_HOURS=2
SELF_DIAGNOSTIC_HOUR=3

# ── Scoring thresholds ──────────────────────────────────────────────────────
AUTO_APPLY_MIN_SCORE=85
REVIEW_MIN_SCORE=65

# ── Safety ──────────────────────────────────────────────────────────────────
MAX_RETRIES=4
PER_CYCLE_APPLY_LIMIT=25

# ── Web ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
