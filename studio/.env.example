# Студия — ключи внешних API. Скопируй в studio/.env и выстави права: chmod 600 studio/.env
# Значения — только здесь; в код/чат/гит не попадают (.env в .gitignore).

ELEVEN_KEY=            # ElevenLabs: транскрипт Scribe, TTS v3, клон-голос, музыка
KIE_KEY=              # kie.ai: видеогенерация (Kling/Seedance/Veo/Wan/Grok)
OPENROUTER_API_KEY=   # OpenRouter: fallback видеомоделей
XAI_API_KEY=          # xAI: Grok Imagine (image-to-video)
PEXELS_API_KEY=       # Pexels: бесплатный сток b-roll
