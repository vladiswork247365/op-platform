# Instagram Graph API — сбор статистики Reels (см. montage/IG-SETUP.md).
# Скопируй в montage/.env, впиши значения, затем: chmod 600 montage/.env
# Файл .env в git НЕ попадает (см. .gitignore).

IG_USER_ID=            # id бизнес/креатор-аккаунта (GET /{page-id}?fields=instagram_business_account)
IG_ACCESS_TOKEN=       # долгоживущий токен с правом instagram_manage_insights
IG_API_VERSION=v21.0   # опц.

# Только для продления токена (python3 montage/ig_stats.py --refresh-token):
IG_APP_ID=
IG_APP_SECRET=
