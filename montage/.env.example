# Instagram Graph API — сбор статистики Reels (см. montage/IG-SETUP.md).
# Скопируй в montage/.env, впиши значения, затем: chmod 600 montage/.env
# Файл .env в git НЕ попадает (см. .gitignore).

# Способ A (по умолчанию) — вход через Instagram, без Facebook-страницы:
IG_ACCESS_TOKEN=       # токен из «API setup with Instagram login» (IGAA...)
# IG_USER_ID здесь НЕ нужен.

# Способ B (запасной) — через Facebook-страницу. Раскомментируй, если нужен:
# IG_AUTH=facebook
# IG_USER_ID=          # id бизнес/креатор-аккаунта
# IG_APP_ID=           # для продления токена
# IG_APP_SECRET=
# IG_API_VERSION=v21.0

# ── Телеграм-бот приёма роликов до 2 ГБ (см. montage/TG-SETUP.md) ──
TG_API_ID=             # число с my.telegram.org → API development tools
TG_API_HASH=           # строка оттуда же
TG_BOT_TOKEN=          # от @BotFather
TG_ALLOW=              # опц.: @username или id через запятую (пусто = всем)

# ── AI-режиссёр + контроль качества «вторые мозги» (OpenRouter) ──
OPENROUTER_API_KEY=    # ключ с openrouter.ai — без него бот работает по ключевым словам
# Мозг системы — по умолчанию Claude Opus 4.5 (режиссёр + контроль качества + сценарии):
# новее и в 3 раза дешевле старого 4.1 ($5/$25 vs $15/$75 за 1М токенов).
# Хочешь дешевле для потока роликов — поставь anthropic/claude-sonnet-4.5 ($3/$15).
# Точный slug модели — на openrouter.ai/models.
OPENROUTER_MODEL=anthropic/claude-opus-4.5
# Vision-модель — «глаза монтажёра» (Claude смотрит каждый клип и раскладывает
# кадр на фразу) + контроль качества. По умолчанию та же модель (Opus 4.5).
# Хочешь удешевить анализ кадров — раскомментируй строку ниже:
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# ── ElevenLabs: озвучка/клон голоса, режим «говорю без звука» (см. VOICE-SETUP.md) ──
ELEVEN_KEY=            # ключ с elevenlabs.io → Profile → API Keys
ELEVEN_VOICE_ID=       # id твоего клон-голоса (создаётся один раз, см. VOICE-SETUP.md)
# ELEVEN_MODEL=eleven_multilingual_v2
# ELEVEN_STABILITY=0.45
# ELEVEN_SIMILARITY=0.85

# ── Ударения (русский TTS): ставим знак ударения перед озвучкой, ElevenLabs читает верно ──
# Из коробки работает встроенный словарь (montage/stress_dict.json). Ничего настраивать не надо.
# Лучшее качество (снимает омографы за́мок/замо́к по контексту):  pip install ruaccent
# STRESS=off            # полностью выключить простановку ударений
# STRESS_ENGINE=dict    # только словарь, не использовать RUAccent (даже если установлен)
# RUACCENT_MODEL=turbo3.1   # размер модели омографов RUAccent (tiny|turbo3|turbo3.1)

# ── TrendSee: «что заходит у других» перед сценарием (тренды в нише) ──
# Авторизация: либо готовый токен, либо логин/пароль (бот залогинится сам).
# Без доступа модуль выключен (сценарий пишется без трендов).
# TRENDSEE_TOKEN=
# TRENDSEE_EMAIL=твой@email
# TRENDSEE_PASSWORD=твой_пароль
# TRENDSEE_QUERY=отдел продаж бизнес РОП
# TRENDSEE_SOCIAL_TYPE=instagram      # опц.: instagram | tiktok
# TRENDSEE_LAST_DAYS=14               # окно поиска, дней
# TRENDSEE_MIN_VIEWS=100000           # опц.: порог просмотров
# TRENDSEE_LIMIT=36                   # сколько тянуть (>10)
